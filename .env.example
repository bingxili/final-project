# Copy this file to .env and fill in your API key(s).

# --- Provider selection ---
# "groq" (default, has free/cheap tier) or "openrouter" (paid)
# LLM_PROVIDER=groq

# --- Groq (used when LLM_PROVIDER=groq, the default) ---
GROQ_API_KEY=your_groq_api_key_here

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: default model for all agents. Must match the naming scheme of
# whichever provider is selected above (Groq and OpenRouter use different
# model catalogues/names).
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL=openai/gpt-5   # example if LLM_PROVIDER=openrouter

# Optional: override the model used by a specific agent role.
# Useful to save TPM budget/cost - see config.py for the rationale.
# By default all roles use LLM_MODEL.
# REQUIREMENTS_MODEL=openai/gpt-oss-120b
# ARCHITECT_MODEL=openai/gpt-oss-120b
# DEVELOPER_MODEL=openai/gpt-oss-120b
# REVIEWER_MODEL=openai/gpt-oss-20b
# TESTER_MODEL=openai/gpt-oss-20b

# Optional: per-agent completion token caps (override config.py defaults
# if needed - defaults are already reasonable for short structured
# artifacts, no need to lower them further just because of provider TPM
# concerns now that OpenRouter's limits are much more generous).
# REQUIREMENTS_MAX_TOKENS=16384
# ARCHITECTURE_MAX_TOKENS=16384
# REVIEW_MAX_TOKENS=16384
# TEST_RESULT_MAX_TOKENS=16384
# DEVELOPER_MAX_TOKENS=16384

# Whether the Developer writes and runs its own self-tests before handing
# off, and how many self-fix attempts it gets if they fail.
# DEVELOPER_SELF_TEST_ENABLED=true
# DEVELOPER_SELF_FIX_ATTEMPTS=1

# Max number of Developer -> Reviewer/Tester revision loops before the
# workflow is forcibly terminated with status "failed_max_revisions".
# MAX_REVISIONS=3

