# Copy this file to .env and fill in your API key(s).

# --- Provider selection ---
# "groq" (default, free/cheap tier) or "openrouter"
# LLM_PROVIDER=groq

# --- Groq (used when LLM_PROVIDER=groq, the default) ---
GROQ_API_KEY=your_groq_api_key_here

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: default model for all agents. Must match the naming scheme of
# whichever provider is selected above (Groq and OpenRouter use different
# model catalogues/names).
# MODEL=openai/gpt-oss-120b
# MODEL=openai/gpt-4o-mini   # example if LLM_PROVIDER=openrouter

# Optional: override the model used by a specific agent role.
# Useful to save TPM budget/cost - see config.py for the rationale.
# By default all roles use MODEL.
# REQUIREMENTS_MODEL=openai/gpt-oss-120b
# ARCHITECT_MODEL=openai/gpt-oss-120b
# DEVELOPER_MODEL=openai/gpt-oss-120b
# REVIEWER_MODEL=openai/gpt-oss-20b
# TESTER_MODEL=openai/gpt-oss-20b

